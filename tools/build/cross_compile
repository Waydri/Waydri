#!/bin/bash
set -euo pipefail

CC="aarch64-linux-android35-clang"
AR="aarch64-linux-android-ar"
PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
OUTPUT_DIR="$PROJECT_ROOT/output/android-libs"
TARGET="aarch64-linux-android"

if ! command -v "$CC" &>/dev/null; then
    NDK_HOME="${ANDROID_NDK_HOME:-$HOME/Android/Sdk/ndk/26.1.10909125}"
    if [ -d "$NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin" ]; then
        export PATH="$NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH"
    fi
fi

if ! command -v "$CC" &>/dev/null; then
    echo "Error: $CC not found in PATH" >&2
    echo "Install Android NDK r26+ or set ANDROID_NDK_HOME." >&2
    exit 1
fi

export CC
export AR
export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$CC"

mkdir -p "$OUTPUT_DIR"

echo "Cross-compiling waydri-core for $TARGET..."
cd "$PROJECT_ROOT"

cargo build \
    --target "$TARGET" \
    --release \
    -p waydri-core

TARGET_DIR="target/$TARGET/release"

for so_file in "$TARGET_DIR"/*.so; do
    if [ -f "$so_file" ]; then
        cp "$so_file" "$OUTPUT_DIR/"
        echo "Copied: $(basename "$so_file")"
    fi
done

echo "Cross-compilation complete. Output: $OUTPUT_DIR"
