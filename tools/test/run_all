#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

cd "$PROJECT_ROOT"

PASS=0
FAIL=0
TOTAL=0

run_suite() {
    local name="$1"
    local cmd="$2"
    TOTAL=$((TOTAL + 1))
    echo "Running: $name"
    if eval "$cmd" 2>&1; then
        echo "  Result: PASS"
        PASS=$((PASS + 1))
    else
        echo "  Result: FAIL"
        FAIL=$((FAIL + 1))
    fi
    echo ""
}

echo "=== Waydri Test Suite ==="
echo ""

echo "[1/4] Unit Tests (cargo test)"
run_suite "cargo test" "cargo test --release 2>&1"

echo "[2/4] Protocol Compliance Tests"
if [ -d "$PROJECT_ROOT/tests/protocol" ]; then
    run_suite "protocol compliance" "cargo test --release --test protocol_compliance 2>&1"
else
    echo "  Skipping: tests/protocol/ not found"
    echo ""
fi

echo "[3/4] Integration Tests"
if [ -d "$PROJECT_ROOT/tests/integration" ]; then
    run_suite "integration" "cargo test --release --test integration 2>&1"
else
    echo "  Skipping: tests/integration/ not found"
    echo ""
fi

echo "[4/4] Lint Checks"
run_suite "clippy" "cargo clippy --release -- -D warnings 2>&1"
run_suite "format check" "cargo fmt -- --check 2>&1"

echo "================================="
echo "Test Summary"
echo "================================="
echo "Total:  $TOTAL"
echo "Passed: $PASS"
echo "Failed: $FAIL"

if [ "$FAIL" -gt 0 ]; then
    echo ""
    echo "Some tests failed."
    exit 1
fi

echo ""
echo "All tests passed."
