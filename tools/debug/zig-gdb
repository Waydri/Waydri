#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
GDBINIT="$SCRIPT_DIR/gdbinit"
REMOTE_HOST=""
REMOTE_PORT="5039"

ZIG_BUILD_DIR="$PROJECT_ROOT/core/zig/build"
BINARY=""

find_binary() {
    local patterns=(
        "$ZIG_BUILD_DIR/waydri"
        "$ZIG_BUILD_DIR/bin/waydri"
        "$ZIG_BUILD_DIR/debug/waydri"
        "$ZIG_BUILD_DIR/release/waydri"
        "$PROJECT_ROOT/target/release/waydri"
    )
    for pattern in "${patterns[@]}"; do
        if [ -f "$pattern" ]; then
            BINARY="$pattern"
            return 0
        fi
    done
    return 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        --remote)
            REMOTE_HOST="$2"
            shift 2
            ;;
        --port)
            REMOTE_PORT="$2"
            shift 2
            ;;
        --binary)
            BINARY="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$BINARY" ]; then
    if ! find_binary; then
        echo "Error: No Waydri binary found. Build first." >&2
        exit 1
    fi
fi

if ! command -v gdb &>/dev/null; then
    echo "Error: gdb not found in PATH" >&2
    exit 1
fi

echo "Starting GDB session for Waydri (aarch64)..."
echo "Binary: $BINARY"

GDB_ARGS=(
    -q
    -ex "set architecture aarch64"
)

if [ -n "$REMOTE_HOST" ]; then
    echo "Connecting to remote: $REMOTE_HOST:$REMOTE_PORT"
    GDB_ARGS+=(-ex "target remote $REMOTE_HOST:$REMOTE_PORT")
else
    GDB_ARGS+=(-ex "target remote :$REMOTE_PORT")
fi

GDB_ARGS+=(
    -ex "set pagination off"
    -ex "set print pretty on"
    -ex "set disassembly-flavor intel"
    -ex "source $GDBINIT"
)

if [ -d "$ZIG_BUILD_DIR" ]; then
    GDB_ARGS+=(-ex "set solib-search-path $ZIG_BUILD_DIR")
fi

exec gdb "${GDB_ARGS[@]}" -- "$BINARY"
