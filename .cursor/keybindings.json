[
    {
        "key": "ctrl+shift+b",
        "command": "workbench.action.tasks.runTask",
        "args": "cargo build"
    },
    {
        "key": "ctrl+shift+t",
        "command": "workbench.action.tasks.runTask",
        "args": "cargo test"
    },
    {
        "key": "ctrl+shift+l",
        "command": "workbench.action.tasks.runTask",
        "args": "cargo clippy"
    },
    {
        "key": "ctrl+shift+f",
        "command": "workbench.action.tasks.runTask",
        "args": "cargo fmt"
    },
    {
        "key": "ctrl+k ctrl+d",
        "command": "editor.action.formatDocument"
    },
    {
        "key": "ctrl+shift+r",
        "command": "editor.action.codeAction",
        "args": {
            "kind": "source.fixAll"
        }
    }
]
